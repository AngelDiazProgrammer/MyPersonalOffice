@* Escena 3D de la oficina (canvas WebGL) y ficha del personaje seleccionado. Solo envía a JavaScript la lista de agentes y los eventos reales; el movimiento es presentación. *@
@inherits OfficeComponentBase
@inject IJSRuntime JS

<div class="scene">
    <canvas @ref="_canvas" aria-label="Oficina virtual en 3D"></canvas>
    <div class="scene-tip" @ref="_tip"></div>
    <div class="scene-hint">Arrastra para rotar · rueda para zoom · clic en un personaje para seguirlo · doble clic para restablecer</div>

    @if (SelectedAgent is { } agent)
    {
        var myTasks = Office.Tasks.Where(t => t.AgentId == agent.Id).ToList();
        var free = myTasks.Count(t => t.Provider?.StartsWith("free:") == true);
        var cloud = myTasks.Count(t => !string.IsNullOrEmpty(t.Provider) && !t.Provider.StartsWith("free:"));
        <aside class="agent-card" style="--agent:@agent.Color">
            <header>
                <span class="agent-card-icon">@agent.Icon</span>
                <div>
                    <b>@agent.Name</b>
                    <span class="muted">@agent.Role</span>
                </div>
                <button type="button" class="agent-card-close" title="Cerrar" @onclick="CloseCardAsync">✕</button>
            </header>
            <span class="status-chip chip-@StatusInfo.Css(agent.Status)"><i></i>@StatusInfo.Label(agent.Status)</span>
            <div class="agent-card-task">@(string.IsNullOrWhiteSpace(agent.CurrentTaskTitle) ? "Sin tarea asignada" : agent.CurrentTaskTitle)</div>
            <div class="agent-card-stats">
                <span title="Tareas completadas">✅ @myTasks.Count(t => t.Status == TaskStatus.Completed)</span>
                <span title="Respondidas por una API gratuita">🆓 @free</span>
                <span title="Respondidas por Claude">☁️ @cloud</span>
            </div>
            @if (agent.CurrentTaskId is { } currentTask && !agent.IsOrchestrator)
            {
                <button type="button" class="link-btn" @onclick="() => Office.CancelTaskAsync(currentTask)">Cancelar tarea actual</button>
            }
            <ul class="agent-card-feed">
                @foreach (var item in Office.Activity.Where(a => a.AgentId == agent.Id).Take(5))
                {
                    <li><span>@item.Timestamp.LocalDateTime.ToString("HH:mm:ss")</span> @item.Description</li>
                }
            </ul>
        </aside>
    }

    @if (_loadError is not null)
    {
        <div class="scene-error">No se pudo iniciar la vista 3D (¿WebGL desactivado?).</div>
    }
</div>

@code {
    private ElementReference _canvas;
    private ElementReference _tip;
    private bool _ready;
    private string _signature = string.Empty;
    private string? _loadError;
    private string? _selectedId;
    private DotNetObjectReference<OfficeScene>? _self;

    private AgentDto? SelectedAgent => _selectedId is null ? null : Office.Agents.FirstOrDefault(a => a.Id == _selectedId);

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Office.EventForwarded += OnOfficeEvent;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                await JS.InvokeVoidAsync("officeUi.sceneReady");
                _self = DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("officeScene.init", _canvas, _tip, _self);
                _ready = true;
                await PushAgentsAsync(resync: true);
                return;
            }

            if (_ready) await PushAgentsAsync(resync: false);
        }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { }
        catch (JSException ex)
        {
            _loadError = ex.Message;
            StateHasChanged();
        }
    }

    /// <summary>La llama la escena 3D cuando la persona hace clic en un personaje (o en el vacío).</summary>
    [JSInvokable]
    public Task OnAgentSelected(string? agentId) => InvokeAsync(() =>
    {
        _selectedId = agentId;
        StateHasChanged();
    });

    private async Task CloseCardAsync()
    {
        _selectedId = null;
        try { await JS.InvokeVoidAsync("officeScene.select", (string?)null); }
        catch (JSDisconnectedException) { }
    }

    // Aquí solo se envía la lista de agentes; el movimiento y los cambios de estado llegan como eventos reales.
    private async Task PushAgentsAsync(bool resync)
    {
        var agents = Office.Agents;
        var signature = string.Join("|", agents.Select(a => $"{a.Id}:{a.Name}:{a.Color}:{a.Icon}"));
        if (!resync && signature == _signature) return;
        _signature = signature;

        var payload = agents.Select(a => new
        {
            id = a.Id,
            name = a.Name,
            role = a.Role,
            color = a.Color,
            icon = a.Icon,
            isOrchestrator = a.IsOrchestrator,
            status = a.Status.ToString(),
            task = a.CurrentTaskTitle
        }).ToArray();

        await JS.InvokeVoidAsync("officeScene.setAgents", payload, resync);
    }

    private async Task OnOfficeEvent(OfficeEventDto e)
    {
        if (!_ready) return;
        try
        {
            await InvokeAsync(() => JS.InvokeVoidAsync("officeScene.event", new
            {
                eventType = e.EventType.ToString(),
                agentId = e.AgentId,
                taskId = e.TaskId,
                description = e.Description,
                additionalData = e.AdditionalData
            }).AsTask());
        }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { }
    }

    public override void Dispose()
    {
        Office.EventForwarded -= OnOfficeEvent;
        _self?.Dispose();
        base.Dispose();
    }
}
