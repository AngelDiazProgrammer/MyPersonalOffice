<article class="desk st-@StatusInfo.Css(Agent.Status) @(Agent.IsOrchestrator ? "is-boss" : string.Empty)"
         style="--agent:@Agent.Color;--agent-dark:@StatusInfo.Shade(Agent.Color, 0.55);--agent-soft:@StatusInfo.Rgba(Agent.Color, 0.16)"
         data-agent="@Agent.Id">
    @if (AssignmentVersion > 0)
    {
        <span class="assign-ring" @key="AssignmentVersion"></span>
        <span class="assign-tag" @key="@("tag" + AssignmentVersion)">📌 Nueva tarea</span>
    }

    @if (StatusInfo.Bubble(Agent.Status) is { Length: > 0 } bubble)
    {
        <div class="bubble bubble-@StatusInfo.Css(Agent.Status)" @key="Agent.Status">@bubble</div>
    }

    @if (Agent.IsOrchestrator)
    {
        <span class="boss-badge" title="Orquestador">★</span>
    }

    <AgentWorkstation Agent="Agent" />

    <footer class="desk-meta">
        <div class="desk-name"><span class="desk-icon">@Agent.Icon</span><strong>@Agent.Name</strong></div>
        <div class="desk-role">@Agent.Role</div>
        <span class="status-chip chip-@StatusInfo.Css(Agent.Status)"><i></i>@StatusInfo.Label(Agent.Status)</span>
        <div class="desk-task" title="@Agent.CurrentTaskTitle">
            @(string.IsNullOrWhiteSpace(Agent.CurrentTaskTitle) ? "Sin tarea asignada" : Agent.CurrentTaskTitle)
        </div>
    </footer>
</article>

@code {
    [Parameter, EditorRequired] public AgentDto Agent { get; set; } = default!;
    [Parameter] public int AssignmentVersion { get; set; }
}
