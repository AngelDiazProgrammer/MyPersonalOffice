@* Pure SVG workstation. Every visual comes from the agent's real status (set by SignalR events). *@
@{
    var s = Agent.Status;
    var typing = s is AgentStatus.Working or AgentStatus.Coding;
}
<svg class="ws ws-@StatusInfo.Css(s)" viewBox="0 0 240 190" role="img" aria-label="@Agent.Name: @StatusInfo.Label(s)">
    <defs>
        <linearGradient id="deskTop-@Agent.Id" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#3b3a78" />
            <stop offset="1" stop-color="#27264f" />
        </linearGradient>
    </defs>

    @* chair *@
    <rect x="60" y="46" width="68" height="76" rx="16" fill="#171a36" stroke="#2a2f5c" />

    @* body *@
    <g class="torso">
        <path d="M68 124 Q68 86 94 82 Q120 86 120 124 Z" fill="var(--agent)" />
        <path d="M86 82 L94 94 L102 82" fill="none" stroke="var(--agent-dark)" stroke-width="2.5" stroke-linejoin="round" />
    </g>

    @* head *@
    <g class="head">
        <rect x="89" y="70" width="10" height="12" rx="3" fill="#e0b08a" />
        <circle cx="94" cy="58" r="17" fill="#f1c9a5" />
        <path d="M76 58 Q75 38 94 38 Q113 38 112 58 Q104 47 94 47 Q84 47 76 58 Z" fill="var(--agent-dark)" />
        @switch (s)
        {
            case AgentStatus.Completed:
                <path d="M84 60 q4 -5 8 0" fill="none" stroke="#2b2140" stroke-width="2" stroke-linecap="round" />
                <path d="M96 60 q4 -5 8 0" fill="none" stroke="#2b2140" stroke-width="2" stroke-linecap="round" />
                <path d="M86 67 Q94 76 102 67" fill="#fff" stroke="#2b2140" stroke-width="1.6" />
                break;
            case AgentStatus.Error:
                <path d="M84 56 l7 7 M91 56 l-7 7 M97 56 l7 7 M104 56 l-7 7" stroke="#2b2140" stroke-width="2" stroke-linecap="round" />
                <path d="M87 71 Q94 65 101 71" fill="none" stroke="#2b2140" stroke-width="2" stroke-linecap="round" />
                <path class="sweat" d="M114 48 q4 6 0 9 q-4 -3 0 -9z" fill="#7dd3fc" />
                break;
            case AgentStatus.Thinking:
                <circle class="eye" cx="89" cy="55" r="2.2" fill="#2b2140" />
                <circle class="eye" cx="101" cy="55" r="2.2" fill="#2b2140" />
                <ellipse cx="94" cy="68" rx="3" ry="3.4" fill="#2b2140" />
                <path d="M83 49 l9 -2 M96 47 l9 2" stroke="#2b2140" stroke-width="1.8" stroke-linecap="round" />
                break;
            case AgentStatus.Idle:
                <path d="M84 59 q4 3 8 0" fill="none" stroke="#2b2140" stroke-width="2" stroke-linecap="round" />
                <path d="M96 59 q4 3 8 0" fill="none" stroke="#2b2140" stroke-width="2" stroke-linecap="round" />
                <path d="M89 68 Q94 71 99 68" fill="none" stroke="#2b2140" stroke-width="1.8" stroke-linecap="round" />
                break;
            default:
                <circle class="eye look-screen" cx="89" cy="59" r="2.2" fill="#2b2140" />
                <circle class="eye look-screen" cx="101" cy="59" r="2.2" fill="#2b2140" />
                <path d="M89 68 Q94 71 99 68" fill="none" stroke="#2b2140" stroke-width="1.8" stroke-linecap="round" />
                break;
        }
    </g>

    @* desk *@
    <rect x="18" y="122" width="204" height="12" rx="3" fill="url(#deskTop-@Agent.Id)" />
    <rect x="18" y="122" width="204" height="2.5" rx="1" fill="var(--agent)" opacity=".55" />
    <rect x="28" y="134" width="184" height="52" rx="4" fill="#1a1a3a" stroke="#2a2f5c" />
    <rect x="34" y="142" width="80" height="14" rx="3" fill="#232352" />
    <rect x="34" y="162" width="80" height="14" rx="3" fill="#232352" />
    <circle cx="74" cy="149" r="2" fill="var(--agent)" />
    <circle cx="74" cy="169" r="2" fill="var(--agent)" />

    @* items on the desk *@
    <rect x="30" y="109" width="11" height="13" rx="2" fill="#e2e8f0" />
    <path d="M41 112 q5 0 5 4 q0 4 -5 4" fill="none" stroke="#e2e8f0" stroke-width="2" />
    <rect x="64" y="116" width="60" height="6" rx="2" fill="#0f1230" stroke="#3b3f7a" />

    @* arms *@
    @switch (s)
    {
        case AgentStatus.Reading:
            <g class="doc">
                <rect x="78" y="94" width="32" height="26" rx="2" fill="#f1f5f9" />
                <rect x="82" y="99" width="24" height="2" fill="#94a3b8" />
                <rect x="82" y="104" width="20" height="2" fill="#94a3b8" />
                <rect class="doc-hl" x="82" y="109" width="24" height="2.4" fill="#34d399" />
                <rect x="82" y="114" width="16" height="2" fill="#94a3b8" />
            </g>
            <line x1="72" y1="96" x2="80" y2="112" stroke="var(--agent)" stroke-width="9" stroke-linecap="round" />
            <line x1="116" y1="96" x2="108" y2="112" stroke="var(--agent)" stroke-width="9" stroke-linecap="round" />
            <circle cx="80" cy="113" r="4.5" fill="#f1c9a5" />
            <circle cx="108" cy="113" r="4.5" fill="#f1c9a5" />
            break;
        case AgentStatus.Thinking:
            <line class="arm-l" x1="72" y1="96" x2="82" y2="118" stroke="var(--agent)" stroke-width="9" stroke-linecap="round" />
            <circle class="arm-l" cx="82" cy="119" r="4.5" fill="#f1c9a5" />
            <line x1="116" y1="96" x2="104" y2="76" stroke="var(--agent)" stroke-width="9" stroke-linecap="round" />
            <circle cx="102" cy="73" r="4.5" fill="#f1c9a5" />
            break;
        case AgentStatus.Completed:
            <line class="arm-l" x1="72" y1="96" x2="82" y2="118" stroke="var(--agent)" stroke-width="9" stroke-linecap="round" />
            <circle class="arm-l" cx="82" cy="119" r="4.5" fill="#f1c9a5" />
            <g class="arm-wave">
                <line x1="116" y1="96" x2="128" y2="66" stroke="var(--agent)" stroke-width="9" stroke-linecap="round" />
                <circle cx="129" cy="62" r="4.5" fill="#f1c9a5" />
            </g>
            break;
        case AgentStatus.Reviewing:
            <line class="arm-l" x1="72" y1="96" x2="82" y2="118" stroke="var(--agent)" stroke-width="9" stroke-linecap="round" />
            <circle class="arm-l" cx="82" cy="119" r="4.5" fill="#f1c9a5" />
            <g class="lens">
                <line x1="116" y1="96" x2="136" y2="88" stroke="var(--agent)" stroke-width="9" stroke-linecap="round" />
                <circle cx="138" cy="87" r="4.5" fill="#f1c9a5" />
                <circle cx="148" cy="80" r="10" fill="rgba(125,211,252,.18)" stroke="#e2e8f0" stroke-width="2.5" />
                <line x1="141" y1="87" x2="145" y2="83" stroke="#e2e8f0" stroke-width="3" stroke-linecap="round" />
            </g>
            break;
        default:
            <line class="@(typing ? "arm-l typing" : "arm-l")" x1="72" y1="96" x2="82" y2="118" stroke="var(--agent)" stroke-width="9" stroke-linecap="round" />
            <circle class="@(typing ? "arm-l typing" : "arm-l")" cx="82" cy="119" r="4.5" fill="#f1c9a5" />
            <line class="@(typing ? "arm-r typing" : "arm-r")" x1="116" y1="96" x2="106" y2="118" stroke="var(--agent)" stroke-width="9" stroke-linecap="round" />
            <circle class="@(typing ? "arm-r typing" : "arm-r")" cx="106" cy="119" r="4.5" fill="#f1c9a5" />
            break;
    }

    @* monitor *@
    <rect x="176" y="106" width="8" height="16" fill="#2a2f5c" />
    <rect x="164" y="119" width="32" height="4" rx="2" fill="#2a2f5c" />
    <rect class="monitor" x="138" y="46" width="84" height="62" rx="6" fill="#0a0e1f" stroke="var(--agent)" stroke-width="2" />
    <rect class="screen-bg" x="144" y="52" width="72" height="50" rx="3" />
    <g class="screen">
        @switch (s)
        {
            case AgentStatus.Thinking:
                <circle class="dot d1" cx="168" cy="77" r="4" />
                <circle class="dot d2" cx="180" cy="77" r="4" />
                <circle class="dot d3" cx="192" cy="77" r="4" />
                break;
            case AgentStatus.Working:
                <rect x="154" y="62" width="52" height="7" rx="3.5" fill="rgba(255,255,255,.12)" />
                <rect class="bar" x="154" y="62" width="52" height="7" rx="3.5" fill="#38bdf8" />
                <rect class="line l1" x="154" y="76" width="40" height="3" rx="1.5" fill="#7dd3fc" />
                <rect class="line l2" x="154" y="84" width="30" height="3" rx="1.5" fill="#7dd3fc" />
                <rect class="line l3" x="154" y="92" width="46" height="3" rx="1.5" fill="#7dd3fc" />
                break;
            case AgentStatus.Coding:
                <rect class="line l1" x="152" y="58" width="22" height="3" rx="1.5" fill="#c084fc" />
                <rect class="line l1" x="177" y="58" width="26" height="3" rx="1.5" fill="#67e8f9" />
                <rect class="line l2" x="158" y="66" width="34" height="3" rx="1.5" fill="#fbbf24" />
                <rect class="line l3" x="158" y="74" width="20" height="3" rx="1.5" fill="#67e8f9" />
                <rect class="line l3" x="181" y="74" width="26" height="3" rx="1.5" fill="#86efac" />
                <rect class="line l4" x="152" y="82" width="30" height="3" rx="1.5" fill="#c084fc" />
                <rect class="line l5" x="158" y="90" width="38" height="3" rx="1.5" fill="#67e8f9" />
                <rect class="cursor" x="198" y="88" width="3" height="7" fill="#e2e8f0" />
                break;
            case AgentStatus.Reading:
                <rect x="160" y="57" width="40" height="40" rx="3" fill="#f1f5f9" opacity=".92" />
                <rect x="166" y="64" width="28" height="3" fill="#94a3b8" />
                <rect x="166" y="72" width="22" height="3" fill="#94a3b8" />
                <rect class="doc-hl" x="166" y="80" width="28" height="3.4" fill="#34d399" />
                <rect x="166" y="88" width="18" height="3" fill="#94a3b8" />
                break;
            case AgentStatus.Reviewing:
                <g class="tick t1"><path d="M154 64 l4 4 l8 -9" fill="none" stroke="#4ade80" stroke-width="2.5" stroke-linecap="round" /><rect x="170" y="63" width="34" height="3" rx="1.5" fill="#94a3b8" /></g>
                <g class="tick t2"><path d="M154 78 l4 4 l8 -9" fill="none" stroke="#4ade80" stroke-width="2.5" stroke-linecap="round" /><rect x="170" y="77" width="28" height="3" rx="1.5" fill="#94a3b8" /></g>
                <g class="tick t3"><path d="M154 92 l4 4 l8 -9" fill="none" stroke="#fbbf24" stroke-width="2.5" stroke-linecap="round" /><rect x="170" y="91" width="32" height="3" rx="1.5" fill="#94a3b8" /></g>
                break;
            case AgentStatus.Waiting:
                <circle cx="180" cy="77" r="17" fill="none" stroke="#fbbf24" stroke-width="3" />
                <line class="hand-m" x1="180" y1="77" x2="180" y2="66" stroke="#fbbf24" stroke-width="2.5" stroke-linecap="round" />
                <line class="hand-h" x1="180" y1="77" x2="188" y2="77" stroke="#fbbf24" stroke-width="2.5" stroke-linecap="round" />
                break;
            case AgentStatus.Completed:
                <circle cx="180" cy="77" r="19" fill="rgba(74,222,128,.15)" stroke="#4ade80" stroke-width="3" />
                <path class="check" d="M170 77 l7 8 l14 -16" fill="none" stroke="#4ade80" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round" />
                break;
            case AgentStatus.Error:
                <circle cx="180" cy="77" r="19" fill="rgba(248,113,113,.15)" stroke="#f87171" stroke-width="3" />
                <path d="M172 69 l16 16 M188 69 l-16 16" stroke="#f87171" stroke-width="4.5" stroke-linecap="round" />
                break;
            default:
                <rect x="154" y="66" width="46" height="3" rx="1.5" fill="rgba(255,255,255,.1)" />
                <rect x="154" y="75" width="34" height="3" rx="1.5" fill="rgba(255,255,255,.1)" />
                <rect class="cursor" x="154" y="86" width="3" height="8" fill="rgba(226,232,240,.6)" />
                break;
        }
    </g>
</svg>

@code {
    [Parameter, EditorRequired] public AgentDto Agent { get; set; } = default!;
}
