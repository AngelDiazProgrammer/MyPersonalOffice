@* Muestra texto Markdown de forma segura (sin HTML crudo, sin imágenes y solo con enlaces permitidos). *@
@using ATLAS.Application.Interfaces
@inject IMarkdownRenderer Markdown

<div class="markdown">@((MarkupString)_html)</div>

@code {
    private string _lastSource = string.Empty;
    private string _html = string.Empty;

    [Parameter] public string Content { get; set; } = string.Empty;

    protected override void OnParametersSet()
    {
        if (_lastSource == Content) return;
        _lastSource = Content;
        _html = Markdown.ToHtml(Content);
    }
}
