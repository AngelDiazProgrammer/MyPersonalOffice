# Copia este archivo a ".env" (está en .gitignore) y completa los valores.
# También puedes definir estas variables en el entorno del sistema.

# API key de Anthropic (https://console.anthropic.com). Nunca se envía al navegador.
ANTHROPIC_API_KEY=

# Modelo Claude a usar. Consulta la lista vigente en https://docs.anthropic.com/en/docs/about-claude/models
ANTHROPIC_MODEL=claude-sonnet-5-5
