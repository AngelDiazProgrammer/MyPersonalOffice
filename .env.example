# Copia este archivo a ".env" (está en .gitignore) y completa los valores.
# También puedes definir estas variables en el entorno del sistema.

# API key de Anthropic (https://console.anthropic.com). Nunca se envía al navegador.
ANTHROPIC_API_KEY=

# Modelo Claude a usar. Consulta la lista vigente en https://docs.anthropic.com/en/docs/about-claude/models
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- APIs gratuitas (se usan ANTES que Claude; ver README) ----

# Groq (https://console.groq.com/keys). Recomendado: activa "Zero Data Retention" en Settings > Data Controls.
GROQ_API_KEY=

# Cloudflare Workers AI (https://dash.cloudflare.com/profile/api-tokens). Necesita token + ID de cuenta.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Google AI Studio / Gemini (https://aistudio.google.com/apikey). Capa gratuita: Google puede usar el contenido para mejorar sus productos,
# así que no la uses con información confidencial (ver README).
GEMINI_API_KEY=

# ---- Camila IA: credenciales de los webhooks del bot (las escribe --camila-generar en tu .env) ----
CAMILA_WH_ENVIO_HSM_ENCUESTA_DE_RETIRO_CAMILA_BASIC=
CAMILA_WH_EVALUACION_DESEMPENO_1_IA_GENERATIVA_CAMILA_BASIC=
CAMILA_WH_EVALUACION_DESEMPENO_2_IA_GENERATIVA_CAMILA_BASIC=
CAMILA_WH_EVALUACION_DESEMPENO_3_IA_GENERATIVA_CAMILA_BASIC=
CAMILA_WH_EVALUACION_DESEMPENO_4_CONTEXTUALIZACION_FECHAS_IA_GENERATIVA_CAMILA_BASIC=
CAMILA_WH_EVALUACION_DESEMPENO_5_LISTAR_ITEM_Y_SOLICITAR_FECHA_PLAN_DE_MEJORAMIENTO_IA_GENERATIVA_CAMILA_BASIC=
CAMILA_WH_EVALUACION_DESEMPENO_6_LISTAR_ITEM_Y_SOLICITAR_FECHA_PLAN_DE_MEJORAMIENTO_IA_GENERATIVA_CAMILA_BASIC=
CAMILA_WH_EXTRAER_INFORMACION_CANDIDATO_DE_W_X_API_PASSWORD=
CAMILA_WH_EXTRAER_INFORMACION_CANDIDATO_DE_W_X_API_USER=
CAMILA_WH_GUARDAR_ACCION_PLAN_EVALUACION_DE_DESEMPENO_BASIC=
CAMILA_WH_IA_GENERATIVA_CAMILA_GENERAL_BASIC=
CAMILA_WH_LIDER_MISION_IA_GENERATIVA_CAMILA_BASIC=
CAMILA_WH_URLPDFEVALUACIONDESEMPENO_BASIC=
