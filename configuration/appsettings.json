{
  "Anthropic": {
    "Model": "claude-sonnet-5-5",
    "BaseUrl": "https://api.anthropic.com",
    "ApiVersion": "2023-06-01",
    "TimeoutSeconds": 120,
    "MaxRetries": 3,
    "MaxConcurrentRequests": 4,
    "MaxOutputTokens": 8192,
    "MaxInputTokensEstimate": 150000
  },
  "Pricing": {
    "InputPerMillionTokens": 0,
    "OutputPerMillionTokens": 0
  },
  "Agents": {
    "Directory": "agents",
    "Definitions": [
      { "Id": "orchestrator", "File": "orchestrator.md" },
      { "Id": "developer", "File": "developer.md" },
      { "Id": "pdf-reader", "File": "pdf-reader.md" },
      { "Id": "teacher", "File": "teacher.md" },
      { "Id": "architect", "File": "architect.md" },
      { "Id": "qa-analyst", "File": "qa-analyst.md" }
    ]
  },
  "Orchestration": {
    "MaxTasksPerRequest": 6,
    "MaxConcurrency": 3,
    "TaskTimeoutSeconds": 180,
    "PlanningTimeoutSeconds": 90,
    "ConsolidationTimeoutSeconds": 120,
    "MaxHistoryMessages": 20,
    "MaxMessageChars": 8000,
    "MaxDocumentCharsPerTask": 60000,
    "ThinkingDisplayMs": 700,
    "CompletedDisplaySeconds": 4
  },
  "Documents": {
    "MaxFileSizeBytes": 10485760,
    "MaxPages": 200,
    "MaxExtractedChars": 200000,
    "AllowedExtensions": [ ".pdf" ]
  },
  "Office": {
    "AllowedOrigins": [ "http://localhost:5080", "https://localhost:7080", "http://localhost:5081" ]
  }
}
