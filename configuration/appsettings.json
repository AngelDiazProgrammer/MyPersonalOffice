{
  "Anthropic": {
    "Model": "claude-haiku-5-5",
    "BaseUrl": "https://api.anthropic.com",
    "ApiVersion": "2023-06-01",
    "TimeoutSeconds": 120,
    "MaxRetries": 3,
    "MaxConcurrentRequests": 4,
    "MaxOutputTokens": 8192,
    "MaxInputTokensEstimate": 150000,
    "PromptCaching": true
  },
  "Pricing": {
    "InputPerMillionTokens": 0,
    "OutputPerMillionTokens": 0
  },
  "Llm": {
    "Mode": "FreeFirst",
    "AllowedRegions": [],
    "FreeProviders": [
      {
        "Name": "groq",
        "Region": "US",
        "BaseUrl": "https://api.groq.com/openai/v1",
        "ApiKeyVariable": "GROQ_API_KEY",
        "Model": "openai/gpt-oss-120b",
        "MaxInputTokens": 6000,
        "MaxOutputTokens": 4096,
        "TimeoutSeconds": 60,
        "ExtraParameters": { "reasoning_effort": "low" }
      },
      {
        "Name": "cloudflare",
        "Region": "Global",
        "BaseUrl": "https://api.cloudflare.com/client/v4/accounts/{CLOUDFLARE_ACCOUNT_ID}/ai/v1",
        "ApiKeyVariable": "CLOUDFLARE_API_TOKEN",
        "Model": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
        "MaxInputTokens": 16000,
        "MaxOutputTokens": 4096,
        "TimeoutSeconds": 60
      }
    ]
  },
  "Workspaces": {
    "Items": [
      {
        "Id": "desarrollo",
        "Name": "Desarrollo",
        "Icon": "💻",
        "Description": "Equipo de software: planifica, diseña, programa, prueba y enseña.",
        "Agents": [ "orchestrator", "architect", "developer", "qa-analyst", "teacher" ]
      },
      {
        "Id": "base-conocimiento",
        "Name": "Pruebas base de conocimiento",
        "Icon": "📚",
        "Description": "Responde incidentes de seguridad consultando la base de conocimiento y entrega el resultado en formato APA (Word y PDF).",
        "Agents": [ "orchestrator", "pdf-reader", "kb-researcher", "incident-responder", "compliance-auditor", "word-writer" ]
      }
    ]
  },
  "Knowledge": {
    "Enabled": true,
    "Directory": "bases de conocimiento",
    "FormatDirectory": "formatos de entrega",
    "MinScore": 4,
    "MaxCandidates": 3,
    "AllowFreeApisWithDocuments": true,
    "OfferSolutionChoice": true
  },
  "Agents": {
    "Directory": "agents",
    "Definitions": [
      { "Id": "orchestrator", "File": "orchestrator.md" },
      { "Id": "developer", "File": "developer.md" },
      { "Id": "pdf-reader", "File": "pdf-reader.md" },
      { "Id": "teacher", "File": "teacher.md" },
      { "Id": "architect", "File": "architect.md" },
      { "Id": "qa-analyst", "File": "qa-analyst.md" },
      { "Id": "word-writer", "File": "word-writer.md" },
      { "Id": "kb-researcher", "File": "kb-researcher.md" },
      { "Id": "incident-responder", "File": "incident-responder.md" },
      { "Id": "compliance-auditor", "File": "compliance-auditor.md" }
    ]
  },
  "Orchestration": {
    "MaxTasksPerRequest": 6,
    "MaxConcurrency": 3,
    "TaskTimeoutSeconds": 300,
    "PlanningTimeoutSeconds": 120,
    "ConsolidationTimeoutSeconds": 180,
    "ConsolidationMaxTokens": 1200,
    "MaxHistoryMessages": 8,
    "HistoryMessageMaxChars": 700,
    "PlanningMaxTokens": 3072,
    "MaxResultCharsForConsolidation": 32000,
    "MaxDependencyResultChars": 6000,
    "SkipConsolidationForSingleTask": true,
    "MaxMessageChars": 8000,
    "MaxDocumentCharsPerTask": 60000,
    "ThinkingDisplayMs": 700,
    "CompletedDisplaySeconds": 4
  },
  "GeneratedDocuments": {
    "Directory": "generated-documents",
    "RetentionHours": 24
  },
  "Documents": {
    "MaxFileSizeBytes": 10485760,
    "MaxPages": 200,
    "MaxExtractedChars": 200000,
    "AllowedExtensions": [ ".pdf" ]
  },
  "Office": {
    "AllowedOrigins": [ "http://localhost:5080", "https://localhost:7080", "http://localhost:5081" ]
  }
}
